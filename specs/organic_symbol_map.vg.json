{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 6: Proportional symbol map of certified organic farmland by country, 2023 (Equal Earth projection). Circle area = organic hectares; colour = organic share of the country's farmland. Nested-circle size legend drawn with the same size scale as the data. Buttons zoom to a region and fade countries outside it. Source: Our World in Data, based on FAO (2025); regions from the UN M49 standard.",
  "width": "container",
  "height": 440,
  "params": [
    {
      "name": "region",
      "value": "World",
      "bind": {
        "input": "radio",
        "options": ["World", "Europe", "Africa", "Asia", "North America", "South America", "Oceania"],
        "name": "Zoom to: "
      }
    },
    {
      "name": "zs",
      "expr": "min(width / (region == 'Europe' ? 1.1507 : region == 'Africa' ? 1.0526 : region == 'Asia' ? 1.8796 : region == 'North America' ? 1.0938 : region == 'South America' ? 0.7217 : region == 'Oceania' ? 1.1707 : 5.4131), height / (region == 'Europe' ? 0.5688 : region == 'Africa' ? 1.4247 : region == 'Asia' ? 1.3368 : region == 'North America' ? 0.973 : region == 'South America' ? 1.2946 : region == 'Oceania' ? 0.8084 : 2.3535)) * (region == 'World' ? 1 : 0.94)"
    }
  ],
  "projection": {
    "type": "equalEarth",
    "rotate": {
      "expr": "[-(region == 'Europe' ? 8 : region == 'Africa' ? 17 : region == 'Asia' ? 88 : region == 'North America' ? -92 : region == 'South America' ? -60 : region == 'Oceania' ? 150 : 0), 0, 0]"
    },
    "scale": {"expr": "zs"},
    "translate": {
      "expr": "[width / 2 - zs * (region == 'Europe' ? -0.0624 : region == 'Africa' ? 0 : region == 'Asia' ? -0.0075 : region == 'North America' ? 0.0075 : region == 'South America' ? 0.0301 : region == 'Oceania' ? 0.015 : 0), height / 2 - zs * (region == 'Europe' ? -0.9331 : region == 'Africa' ? -0.027 : region == 'Asia' ? -0.4463 : region == 'North America' ? -0.6281 : region == 'South America' ? 0.3851 : region == 'Oceania' ? 0.5054 : -0.13)]"
    }
  },
  "layer": [
    {
      "data": {"url": "data/world-50m.json", "format": {"type": "topojson", "feature": "countries"}},
      "transform": [
        {"calculate": "toNumber(datum.id)", "as": "id"},
        {"filter": "datum.id != 10"},
        {"lookup": "id", "from": {"data": {"url": "data/country_continents.csv"}, "key": "id", "fields": ["continent"]}}
      ],
      "mark": {"type": "geoshape", "stroke": "#F4F2EC", "strokeWidth": 0.5, "clip": true},
      "encoding": {
        "color": {
          "condition": {"test": "region == 'World' || datum.continent == region", "value": "#E2E0D8"},
          "value": "#ECEAE3"
        }
      }
    },
    {
      "data": {"url": "data/organic_area_2023.csv"},
      "transform": [
        {"filter": "datum.organic_ha >= 10000"},
        {"lookup": "iso3", "from": {"data": {"url": "data/country_continents.csv"}, "key": "iso3", "fields": ["continent"]}},
        {
          "calculate": "datum.organic_share_pct < 1 ? 'Under 1%' : datum.organic_share_pct < 5 ? '1% to 5%' : datum.organic_share_pct < 15 ? '5% to 15%' : '15% or more'",
          "as": "share_band"
        },
        {"calculate": "format(datum.organic_ha, ',.0f') + ' ha'", "as": "ha_label"},
        {"calculate": "format(datum.organic_share_pct, '.1f') + '%'", "as": "share_label"}
      ],
      "params": [
        {"name": "share_pick", "select": {"type": "point", "fields": ["share_band"]}, "bind": "legend"},
        {"name": "hover_c", "select": {"type": "point", "fields": ["iso3"], "on": "pointerover", "clear": "pointerout"}}
      ],
      "mark": {"type": "circle", "stroke": "#1E2B26", "strokeWidth": 0.5, "clip": true},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "organic_ha",
          "type": "quantitative",
          "title": "Organic farmland (hectares)",
          "scale": {"type": "linear", "zero": true, "range": [30, 5200]},
          "legend": null
        },
        "color": {
          "field": "share_band",
          "type": "ordinal",
          "title": "Organic share of its farmland",
          "scale": {
            "domain": ["Under 1%", "1% to 5%", "5% to 15%", "15% or more"],
            "range": ["#B5D3E0", "#5B9DBA", "#1F6E8C", "#0B3D52"]
          },
          "legend": {"orient": "top-left", "direction": "vertical", "symbolType": "circle", "symbolSize": 110, "titleLimit": 0, "offset": 12, "padding": 0}
        },
        "opacity": {
          "condition": {
            "test": {"and": [{"param": "share_pick"}, "region == 'World' || datum.continent == region"]},
            "value": 0.92
          },
          "value": 0.08
        },
        "strokeWidth": {"condition": {"param": "hover_c", "empty": false, "value": 2}, "value": 0.5},
        "order": {"field": "organic_ha", "sort": "descending"},
        "tooltip": [
          {"field": "country", "title": "Country"},
          {"field": "ha_label", "title": "Organic farmland"},
          {"field": "share_label", "title": "Share of its farmland"}
        ]
      }
    },
        {
      "data": {
        "values": [
          {"organic_ha": 50000000, "r": 35.02, "label": "50 million ha"},
          {"organic_ha": 20000000, "r": 22.25, "label": "20 million ha"},
          {"organic_ha": 10000000, "r": 15.85, "label": "10 million ha"},
          {"organic_ha": 1000000, "r": 5.65, "label": "1 million ha"}
        ]
      },
      "transform": [
        {"calculate": "200 - datum.r", "as": "cy"},
        {"calculate": "200 - 2 * datum.r", "as": "ty"}
      ],
      "layer": [
        {
          "mark": {"type": "circle", "fill": "#B9C0BB", "fillOpacity": 0.35, "stroke": "#4A5650", "strokeWidth": 0.8},
          "encoding": {
            "x": {"value": 42},
            "y": {"field": "cy", "type": "quantitative", "scale": null},
            "size": {"field": "organic_ha", "type": "quantitative"}
          }
        },
        {
          "mark": {"type": "rule", "stroke": "#4A5650", "strokeWidth": 0.6, "strokeDash": [2, 2]},
          "encoding": {
            "x": {"value": 42},
            "x2": {"value": 90},
            "y": {"field": "ty", "type": "quantitative", "scale": null}
          }
        },
        {
          "mark": {"type": "text", "align": "left", "baseline": "middle", "fontSize": 11, "color": "#1E2B26"},
          "encoding": {
            "x": {"value": 94},
            "y": {"field": "ty", "type": "quantitative", "scale": null},
            "text": {"field": "label"}
          }
        },
        {
          "data": {"values": [{"t": "Organic farmland"}]},
          "mark": {"type": "text", "align": "left", "baseline": "bottom", "fontSize": 11, "fontWeight": 700, "color": "#1E2B26", "x": 0, "y": 118},
          "encoding": {"text": {"field": "t"}}
        }
      ]
    },
    {
      "data": {
        "values": [
          {"lon": 107, "lat": -19, "t": "Australia: 53 million ha,"},
          {"lon": 107, "lat": -25, "t": "mostly cattle grazing land"}
        ]
      },
      "mark": {"type": "text", "align": "right", "fontSize": 12, "color": "#1E2B26", "fontWeight": 600, "clip": true},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "t"},
        "opacity": {"condition": {"test": "region == 'World'", "value": 1}, "value": 0}
      }
    },
    {
      "data": {
        "values": [
          {"lon": -19, "lat": 50, "t": "Europe: less organic land, but"},
          {"lon": -19, "lat": 44.5, "t": "a much bigger share of its farms"}
        ]
      },
      "mark": {"type": "text", "align": "right", "fontSize": 12, "color": "#1E2B26", "fontWeight": 600, "clip": true},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "t"},
        "opacity": {"condition": {"test": "region == 'World'", "value": 1}, "value": 0}
      }
    },
    {
      "data": {"values": [{"lon": -168, "lat": -9, "t": "Samoa: 85% of farmland is organic"}]},
      "mark": {"type": "text", "align": "left", "fontSize": 12, "color": "#1E2B26", "fontWeight": 600, "clip": true},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "t"},
        "opacity": {"condition": {"test": "region == 'World'", "value": 1}, "value": 0}
      }
    }
  ]
}