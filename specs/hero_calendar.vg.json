{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Hero: the 365 days of 2026 as a grid of 73 columns x 5 rows, filled day by day. The first 75 days (up to Australia's Overshoot Day, 16 March) are teal; the rest of the year is 'borrowed'. Annotated at 16 March.",
  "width": "container",
  "height": 100,
  "data": {"sequence": {"start": 1, "stop": 366, "as": "day"}},
  "transform": [
    {"calculate": "datetime(2026, 0, datum.day)", "as": "date"},
    {"calculate": "floor((datum.day - 1) / 5)", "as": "col"},
    {"calculate": "(datum.day - 1) % 5", "as": "row"},
    {"calculate": "datum.day <= 75 ? 'Covered by this year’s resources' : 'Borrowed from the future'", "as": "status"}
  ],
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "title": null,
      "scale": {"paddingInner": 0.18},
      "axis": {
        "orient": "bottom", "domain": false, "ticks": false, "labelPadding": 6, "labelAngle": 0, "labelAlign": "left",
        "labelExpr": "date(datetime(2026, 0, datum.value * 5 + 1)) == 1 ? timeFormat(datetime(2026, 0, datum.value * 5 + 1), '%b') : month(datetime(2026, 0, datum.value * 5 + 5)) != month(datetime(2026, 0, datum.value * 5 + 1)) ? timeFormat(datetime(2026, 0, datum.value * 5 + 5), '%b') : ''"
      }
    },
    "y": {"field": "row", "type": "ordinal", "axis": null, "scale": {"domain": [-1, 0, 1, 2, 3, 4], "paddingInner": 0.18}}
  },
  "layer": [
    {
      "mark": {"type": "rect", "cornerRadius": 1.5},
      "encoding": {
        "color": {
          "field": "status",
          "type": "nominal",
          "title": null,
          "scale": {"domain": ["Covered by this year’s resources", "Borrowed from the future"], "range": ["#1F6E8C", "#E3B76F"]},
          "legend": {"orient": "bottom", "direction": "horizontal", "symbolType": "square", "symbolSize": 120, "labelFontSize": 13, "labelLimit": 0, "columnPadding": 28, "offset": 14}
        },
        "tooltip": [
          {"field": "date", "type": "temporal", "title": "Date", "format": "%-d %B"},
          {"field": "status", "title": "Status"}
        ]
      }
    },
    {
      "data": {"values": [{"col": 15, "row": -1, "t": "16 March: a full year’s share, used up"}]},
      "layer": [
        {
          "mark": {"type": "rule", "color": "#1E2B26", "strokeWidth": 1.5, "xOffset": -1.5},
          "encoding": {
            "x": {"field": "col", "type": "ordinal", "bandPosition": 0},
            "y": {"datum": -1},
            "y2": {"datum": 4, "bandPosition": 1}
          }
        },
        {
          "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 4, "fontSize": 12, "fontWeight": 700, "color": "#1E2B26"},
          "encoding": {
            "x": {"field": "col", "type": "ordinal", "bandPosition": 0},
            "y": {"field": "row", "type": "ordinal"},
            "text": {"field": "t"}
          }
        }
      ]
    }
  ]
}